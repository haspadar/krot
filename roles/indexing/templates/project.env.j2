{{ ansible_managed | comment }}
# Only the keys of engines {{ indexing_project.key }} declares: a key left here
# for an engine dropped from the inventory has no reason to stay on the machine.
{% set spec = indexing_project.value %}
{% if 'google' in spec.engines %}
KROT_INDEX_GOOGLE_KEY_FILE={{ indexing_config_dir }}/{{ indexing_project.key }}.google.json
{% endif %}
{% if 'bing' in spec.engines %}
KROT_INDEX_BING_KEY={{ spec.bing_key }}
{% endif %}
{% if 'yandex' in spec.engines %}
KROT_INDEX_YANDEX_TOKEN={{ spec.yandex_token }}
{% endif %}
{% if 'indexnow' in spec.engines %}
KROT_INDEX_INDEXNOW_SECRET={{ spec.indexnow_secret }}
{% endif %}
