{{ ansible_managed | comment }}
# Only the keys of engines {{ indexing_plan.name }} declares: a key left here for
# an engine dropped from the inventory has no reason to stay on the machine.
{% set keys = indexing_projects[indexing_plan.name] %}
{% if 'google' in indexing_plan.engines %}
KROT_INDEX_GOOGLE_KEY_FILE={{ indexing_config_dir }}/{{ indexing_plan.name }}.google.json
{% endif %}
{% if 'bing' in indexing_plan.engines %}
{# Absent where every Bing site is in an account: the role has already refused a missing key otherwise. #}
{% if keys.bing_key | default('') | string | trim | length > 0 %}
KROT_INDEX_BING_KEY={{ keys.bing_key | string | trim }}
{% endif %}
{# One variable per Bing account, in the order of the names so a second pass writes the same file. #}
{% for account, account_key in (keys.bing_accounts | default({})) | dictsort %}
KROT_INDEX_BING_KEY_{{ account | upper }}={{ account_key | string | trim }}
{% endfor %}
{% endif %}
{% if 'yandex' in indexing_plan.engines %}
KROT_INDEX_YANDEX_TOKEN={{ keys.yandex_token | string | trim }}
{% endif %}
{% if 'indexnow' in indexing_plan.engines %}
KROT_INDEX_INDEXNOW_SECRET={{ keys.indexnow_secret | string | trim }}
{% endif %}
