{{ ansible_managed | comment }}
{{ indexing_unit_marker }}
{% set project = item.0.name %}
{% set engine = item.1 %}
[Unit]
Description={{ ("Count what the engines hold of " ~ project ~ "'s sites") if engine == 'counts' else ("Offer " ~ project ~ "'s pages to " ~ engine) }}
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ indexing_user }}
EnvironmentFile={{ indexing_config_dir }}/{{ project }}.env
Environment=PYTHONPATH={{ indexing_program_dir }}
# Unbuffered: piped to the journal, stdout is block-buffered and every "offered" line got the
# second the program exited, while stderr kept its real time.
Environment=PYTHONUNBUFFERED=1
# A site that hangs must not hold the unit: the timer would keep firing into a
# unit still active and the engine would stop being offered, green.
TimeoutStartSec={{ indexing_timeouts[engine] }}
# Exit 1 means a person is needed; a spent allowance or a throttle exits 0.
# `counts` only reads statistics, so a red one never means an allowance is spent.
{% if engine == 'counts' %}
ExecStart=/usr/bin/python3 -m krot_index.counts --config {{ indexing_config_dir }}/{{ project }}.json
{% else %}
ExecStart=/usr/bin/python3 -m krot_index --config {{ indexing_config_dir }}/{{ project }}.json --engine {{ engine }}
{% endif %}
