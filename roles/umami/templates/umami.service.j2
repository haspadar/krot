{{ ansible_managed | comment }}
# The counter that measures the sites on this machine. Reached only over the
# loopback, by the sites' own nginx — see the proxy_pass blocks in the vhost
# that serves it from each site's own domain.

[Unit]
Description=Umami analytics
Documentation=https://umami.is/docs
# Wants rather than Requires: the database is on this machine today and may not
# be tomorrow. Requires would tie this unit's fate to a service it merely talks
# to, and on a machine where postgres is remote it would refuse to start at all.
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User={{ umami_user }}
Group={{ umami_group }}
WorkingDirectory={{ umami_release_dir }}

# The standalone server Next writes at build time, not `pnpm start`: it carries
# its own traced dependencies and starts without a package manager in the path.
ExecStart=/usr/bin/node {{ umami_release_dir }}/.next/standalone/server.js

# Both named explicitly. server.js reads HOSTNAME and PORT, and its default for
# the first is 0.0.0.0 — so an unset value does not fail, it publishes the
# service to every interface while looking exactly like a healthy start.
Environment=HOSTNAME={{ umami_bind_host }}
Environment=PORT={{ umami_port }}
Environment=NODE_ENV=production
# Nothing on this machine reports to Vercel.
Environment=NEXT_TELEMETRY_DISABLED=1

# The database password and the signing secret live here, 0640, so that
# `systemctl cat umami` — which any account on the machine may run — prints the
# unit without printing them.
EnvironmentFile={{ umami_root }}/umami.env

Restart=on-failure
RestartSec=5s

# ⚠️ The rate limit matters more than it looks. systemd's default gives up after
# five starts in ten seconds, which bounds a service that dies IMMEDIATELY — but
# not one that starts, listens, and dies half a minute later on a schema it
# cannot use. That one never trips the default burst and loops forever: thirty
# seconds alive, five dead, spawning a Node process each time on a machine with
# 3.8 GB and nine sites on it. A wider window catches the slow failure too.
StartLimitIntervalSec=300
StartLimitBurst=5

# The same reasoning the build applies to its heap, applied to the service. Node
# sizes itself from total system memory rather than free memory, so a counter
# that misbehaves competes with postgres for the last of it — and the OOM killer
# picks by its own score, which on a database machine lands on postgres as
# readily as on the offender.
MemoryMax={{ umami_memory_max }}

# Hardening. The service reads a build it does not own and writes nothing
# outside its own tree; everything below says so to the kernel rather than
# trusting the application to behave.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# ⚠️ Not decoration on THIS machine. /proc/<pid>/environ holds the resolved
# environment of a running process, so the 0640 split that keeps the database
# password out of `systemctl cat` ends the moment the service starts unless the
# rest of /proc is hidden from it — and, in the other direction, this account
# could otherwise read the environment of every php-fpm worker serving the nine
# sites beside it.
ProtectProc=invisible
ProcSubset=pid
# Nothing here needs a capability, and saying so is cheaper than auditing later
# which one crept in.
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# Next writes its runtime cache under the release tree, so that one path is
# writable and the rest of the filesystem is not.
ReadWritePaths={{ umami_release_dir }}
# Loopback and the database socket are all it needs; no raw sockets, no
# anything else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
