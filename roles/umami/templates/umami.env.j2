{{ ansible_managed | comment }}
# Read by the unit through EnvironmentFile=. Kept apart from the unit so that
# rotating a secret rewrites this one 0640 file instead of the unit — and so
# that `systemctl cat umami`, which anyone on the machine may run, does not
# print the database password.
#
# systemd's EnvironmentFile parser is not a shell: VAR=value, no expansion, no
# command substitution, and a value is taken literally to the end of the line.
# So nothing here is quoted — quotes would arrive as part of the value.

DATABASE_URL={{ umami_database_url }}

# Signs sessions and encrypts stored tokens. Without it Umami derives the key
# from DATABASE_URL (src/lib/crypto.ts: hash(APP_SECRET || DATABASE_URL)), and
# every session on the machine dies the day that password is rotated.
APP_SECRET={{ umami_app_secret }}
{% for key, value in umami_environment.items() %}
{{ key }}={{ value }}
{% endfor %}
