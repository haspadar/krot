{{ ansible_managed | comment }}
# Read from conf.d/, so these values override postgresql.conf.

listen_addresses = '{{ postgresql_listen_addresses }}'
port = {{ postgresql_port }}
max_connections = {{ postgresql_max_connections }}

shared_buffers = {{ postgresql_shared_buffers }}
effective_cache_size = {{ postgresql_effective_cache_size }}
work_mem = {{ postgresql_work_mem }}
maintenance_work_mem = {{ postgresql_maintenance_work_mem }}

{% set preload = postgresql_shared_preload_libraries
   + (['pg_stat_statements'] if postgresql_stat_statements else []) %}
{% if preload %}
# Loaded at postmaster start, so changing this line requires a restart, not a
# reload. The whole list is written at once: PostgreSQL takes the last assignment
# verbatim and has no append syntax, so a second writer would drop these rather
# than extend them. Add libraries to postgresql_shared_preload_libraries.
shared_preload_libraries = '{{ preload | unique | join(",") }}'
{% endif %}
{% if postgresql_stat_statements %}

# Aggregated per-query statistics. Catches the cheap statement called constantly,
# which never crosses log_min_duration_statement and so never reaches the log.
pg_stat_statements.max = {{ postgresql_stat_statements_max }}
pg_stat_statements.track = {{ postgresql_stat_statements_track }}
{% endif %}

# Logging. csvlog has a fixed column layout, so a shipper parses it without
# guessing at the prefix format.
logging_collector = on
log_destination = '{{ postgresql_log_destination }}'
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d.log'
log_line_prefix = '{{ postgresql_log_line_prefix }}'

# PostgreSQL rotates its own logs; a dated filename plus truncate-on-rotation
# means the set recycles after a year instead of growing without bound, so no
# logrotate entry accompanies this role.
log_rotation_age = 1d
log_rotation_size = 0
log_truncate_on_rotation = on
log_file_mode = 0640

# Slow queries are the signal worth keeping; logging every statement would bury
# it and fill the disk.
log_min_duration_statement = {{ postgresql_log_min_duration_ms }}
log_checkpoints = on
log_connections = on
log_disconnections = on
log_lock_waits = on
log_temp_files = 0
log_autovacuum_min_duration = 0
