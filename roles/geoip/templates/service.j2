{{ ansible_managed | comment }}

[Unit]
Description=Refresh the MaxMind GeoIP databases
Documentation=man:geoipupdate(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/geoipupdate

# It fetches files over HTTPS and writes them to one directory. Root is needed
# to read the credentials and write there; nothing else on the host is its
# business.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths={{ geoip_database_dir }}
