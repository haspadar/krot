{{ ansible_managed | comment }}

[Unit]
Description=Refresh the MaxMind GeoIP databases {{ geoip_update_interval }}

[Timer]
OnCalendar={{ geoip_update_interval }}
# Every host with this role would otherwise ask MaxMind at the same second.
RandomizedDelaySec=3600
# A machine that was off when the timer was due still refreshes rather than
# waiting for the next window with a database that much older.
Persistent=true

[Install]
WantedBy=timers.target
