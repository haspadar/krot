{{ ansible_managed | comment }}
#
# Downloads one object. Used by the restore rehearsal and by the restore itself,
# never by the backup.
#
# ⚠️ The exit code carries a distinction the caller depends on, and it comes
# from `send`: 3 means the object is not there, 1 means storage refused us or
# could not be reached, and the reason is on stderr in both cases. A restore
# probes seven nights and expects most of them to be absent — reading a refusal
# as an absence is what makes a rotated key print "no backups exist".
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from s3_put import object_path, request, send  # noqa: E402


def main() -> None:
    key, destination = sys.argv[1], sys.argv[2]
    bucket = os.environ["BACKUP_S3_BUCKET"]

    body = send(request("GET", object_path(bucket, key), b""))

    with open(destination, "wb") as handle:
        handle.write(body)

    print(f"fetched {key} ({len(body)} bytes)")


if __name__ == "__main__":
    main()
