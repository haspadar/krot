#!/usr/bin/env python3
{{ ansible_managed | comment }}
#
# Downloads one object. Used by the restore rehearsal, never by the backup
# itself.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from s3_put import object_path, request, send  # noqa: E402


def main() -> None:
    key, destination = sys.argv[1], sys.argv[2]
    bucket = os.environ["BACKUP_S3_BUCKET"]

    body = send(request("GET", object_path(bucket, key), b""))

    with open(destination, "wb") as handle:
        handle.write(body)

    print(f"fetched {key} ({len(body)} bytes)")


if __name__ == "__main__":
    main()
