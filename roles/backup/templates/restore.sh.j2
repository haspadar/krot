#!/usr/bin/env bash
{{ ansible_managed | comment }}
#
# ⚠️ The shebang is the FIRST line, above the managed banner. Unlike its two
# neighbours this script is not exec'd by systemd, so it would not die with
# "Exec format error" — a shell that gets ENOEXEC falls back to interpreting the
# file itself, and it would appear to work. That is the worse outcome: the
# fallback interpreter is whatever shell the operator happens to run, and this
# script is bash-specific (`{lock_fd}`, `read -p`, `local`). It would work for
# everyone testing it and break for whoever restores from a different shell.
#
# Restores one database from the nightly copies, over what is there now.
#
# Not a timer: this is run by a person, on the worst day, and the value it adds
# is that the sequence is written down rather than remembered. Restoring is the
# rarest operation here and the one performed under the most pressure — the data
# is already gone — so it is the last place a sequence should be assembled from
# memory. Measured 2026-08-29 in busel: a destructive sequence retyped by hand
# reached the wrong database twice in one day.
#
# Judges the copy the way `verify.sh` does — by what arrived, not by pg_restore's
# exit code, which is 0 on a dump carrying structure and nothing else.
set -euo pipefail

# ⚠️ Read here, not inherited. `backup.sh` and `verify.sh` are started by systemd
# units carrying `EnvironmentFile=`, so the credentials arrive without either
# script mentioning them — and this one has no unit, because a person runs it.
# Copied from their pattern, it fetched nothing and reported "no complete set in
# the last seven nights": a missing variable reads as a missing backup, which is
# the most alarming way possible to say "wrong environment".
#
# Sourced rather than required from the caller: the operator running this has
# just lost data and should not also have to know which file holds the keys.
if [ -r "{{ backup_script_dir }}/storage.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "{{ backup_script_dir }}/storage.env"
    set +a
else
    echo "Cannot read {{ backup_script_dir }}/storage.env as $(id -un). It is 0600 and" >&2
    echo "owned by {{ backup_pg_user }}, so restoring has to run as root:" >&2
    echo "  sudo krot-restore $*" >&2
    exit 1
fi

# ⚠️ Two identities, and they are not the same one. `storage.env` is 0600 owned
# by `postgres` — the timers run as that user and read it through systemd's
# `EnvironmentFile=` — so the only accounts that can read it are `postgres` and
# root. The cluster, meanwhile, is reachable only as `postgres`, and `postgres`
# is not in sudoers: it can read the keys but cannot become itself through sudo.
# A script picking either identity alone fails on the other half, and the failure
# names the half it reached: run as postgres it says "no complete set in the last
# seven nights", run as an operator without root it says the keys are unreadable.
# Neither mentions the identity, which is the actual fault.
#
# So: root reads the keys, and every psql-family call goes through this.
#
# ⚠️ `backup_pg_user`, not a literal. The units, the credentials file and the
# whole rest of the role are rendered from that variable, and a machine that
# overrode it would have this script alone still reaching for `postgres` — which
# either does not exist or is the wrong account, and the failure reads as peer
# authentication rather than as a hardcoded name. The database `postgres` below
# is a different thing and stays literal: it is the maintenance database every
# cluster has, not an account anyone configures.
as_postgres() {
    sudo -u {{ backup_pg_user | quote }} "$@"
}

# ⚠️ Asked ONCE, up front, and not left to be discovered by the first failure.
# `postgres` is not in sudoers — only root and the operator account are — so run
# as `postgres` every call through `as_postgres` fails, prints its complaint to
# stderr, and returns nothing. The lookup below then finds no matching row and
# says "No database named X on this machine", which is a lie of the worst kind:
# it names the operator's own database as the fault on the day they are trying
# to get it back. Measured 2026-08-29 in a container against a database that
# demonstrably existed.
#
# The check is `sudo -n`: the question is whether this identity may become
# postgres without being asked for anything, which is the only mode a script has.
if ! sudo -n -u {{ backup_pg_user | quote }} true 2>/dev/null; then
    echo "Running as $(id -un), which may not become {{ backup_pg_user }}. Restoring" >&2
    echo "reads credentials owned by {{ backup_pg_user }} and reaches the cluster as" >&2
    echo "that account, which is not in sudoers — so this has to run as root:" >&2
    echo "  sudo krot-restore $*" >&2
    exit 1
fi

work_dir={{ backup_work_dir | quote }}-restore
prefix={{ backup_prefix | quote }}
# ⚠️ An underscore, not a hyphen. `krot_restore_check-restore` is not a valid
# unquoted identifier, and createdb takes it while psql then needs it quoted
# everywhere — the mismatch shows up as "syntax error at or near" halfway
# through, after the download.
scratch={{ backup_verify_database }}_restore

usage() {
    cat >&2 <<USAGE
Usage: krot-restore <database> [--day YYYY-MM-DD] [--force]

  <database>   the database to restore INTO — its current contents are replaced
  --day        which nightly set to take; default is the newest complete one
  --force      do not ask; for scripts and runs without a terminal
USAGE
    exit 2
}

target=""
day=""
force=no

while [ $# -gt 0 ]; do
    case "$1" in
        # ⚠️ `${2:-}` is empty only at the end of the arguments, so `--day
        # --force` took `--force` as the date and quietly turned the force off.
        # The flag has to reject a value that is another flag, not just a
        # missing one.
        --day)
            case "${2:-}" in
                ""|-*) echo "--day needs a date, as YYYY-MM-DD." >&2; usage ;;
            esac
            day="$2"; shift 2
            ;;
        --force) force=yes; shift ;;
        -h|--help) usage ;;
        -*)      echo "Unknown option: $1" >&2; usage ;;
        *)       [ -z "$target" ] || usage; target="$1"; shift ;;
    esac
done

[ -n "$target" ] || usage

# ⚠️ Checked before the name reaches a SQL string, and it reaches two of them —
# the existence lookup and the owner lookup — both by interpolation rather than
# by a parameter, because psql -c takes no bind values. A name carrying a quote
# would close the literal and leave whatever follows to run as a statement of
# its own, as root, on the day the operator is already restoring. This script
# exists BECAUSE a hand-typed destructive command reached the wrong database
# twice in one day; it should not offer a third way.
#
# The pattern is what an unquoted PostgreSQL identifier may be, which is what
# every database on this machine is named.
case "$target" in
    *[!A-Za-z0-9_]* | [!A-Za-z_]*)
        echo "\"$target\" is not a plain database name — letters, digits and" >&2
        echo "underscores only, not starting with a digit." >&2
        exit 1
        ;;
esac

# The same, for the day: it becomes part of a storage key.
if [ -n "$day" ]; then
    case "$day" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
        *) echo "--day takes a date as YYYY-MM-DD, not \"$day\"." >&2; exit 1 ;;
    esac
fi

# ⚠️ Refused before anything is downloaded. Restoring into a database that does
# not exist would have to create it, and a typo would then be answered with a new
# empty database named after the mistake — which reads as success right up until
# something tries to read the real one.
if ! as_postgres psql -tAX -d postgres -c \
        "select 1 from pg_database where datname = '$target'" | grep -q 1; then
    echo "No database named $target on this machine. Restoring cannot create it — check the name." >&2
    exit 1
fi

# ⚠️ One restore at a time, and the lock is taken BEFORE the working directory is
# cleared. Two runs share this path and the scratch database name, and the first
# thing each does is `rm -rf` the other's downloaded dump — so a second operator,
# or an impatient second attempt, turns one restore into two half-restores of
# whichever dump survived. The lock lives outside the working directory for two
# reasons: the directory is what gets deleted, and /var/tmp is the wrong place
# for it anyway — see below.
#
# `-n` rather than a wait: the second run should say so and stop, not sit
# silently behind the first on the day someone is watching for output.
#
# ⚠️ In /run/lock, NOT beside the working directory. /var/tmp is world-writable
# with a sticky bit, so any local account could create and hold this file before
# the first restore ever runs — and every emergency restore would then refuse,
# with a message blaming a concurrent run that does not exist. Worse, a root
# redirection onto a predictable path in a world-writable directory is a symlink
# target: where protected_symlinks is off, it truncates whatever the link points
# at. /run/lock is root-owned, which is the whole requirement here.
exec {lock_fd}>/run/lock/krot-restore.lock
if ! flock -n "$lock_fd"; then
    echo "Another restore is running on this machine — it holds $work_dir and the" >&2
    echo "scratch database. Wait for it rather than starting a second: they would" >&2
    echo "delete each other's downloads halfway through." >&2
    exit 1
fi

rm -rf "$work_dir"
mkdir -p "$work_dir"
# ⚠️ 0700 would be right if one user did all of this. Two do: root downloads here
# and {{ backup_pg_user }} reads the dump back out through pg_restore, so a
# private directory means "No such file or directory" on a file that plainly
# exists.
#
# 711 rather than 755: traversable, so a known path can be opened, but not
# listable, so the database names are not on offer to every local account. What
# the files themselves allow is set on the files — see the dump below.
chmod 711 "$work_dir"

# The scratch database goes whether this succeeded or died halfway. A leftover
# would be picked up by the next night's backup as an ordinary database and
# copied — the copies would start feeding themselves.
cleanup() {
    rm -rf "$work_dir"
    as_postgres dropdb --if-exists "$scratch" || true
}
trap cleanup EXIT

# ⚠️ The marker first, and it is what makes a set a set. `_complete` is uploaded
# last, so a night that died on the fourth of nine uploads has dumps in the
# bucket and no marker — and restoring from it would produce a database that
# looks whole. Named days are checked for the marker too: asking for a specific
# day is not a reason to accept an unfinished one.
# ⚠️ An absence and a refusal are different answers, and only one of them means
# "look for another day". `s3_get.py` exits 3 when the object is not there and 1
# when storage would not answer — so a rotated key, a wrong bucket or an outage
# stops here naming itself, instead of being counted as one more missing night
# and reported at the end as "no backups exist". Measured 2026-08-29: with a
# valid dump in place and a wrong secret, this printed "No complete set in the
# last seven nights" while storage was answering 403 SignatureDoesNotMatch, and
# the operator was sent to inspect a timer that was running.
#
# stderr is NOT discarded for the same reason: `send` prints the status and the
# body, and the body is where S3 says whether the fault is the key or the name.
fetch() {
    local key="$1" into="$2" status=0

    "{{ backup_script_dir }}/s3_get.py" "$key" "$into" || status=$?

    if [ "$status" -ne 0 ] && [ "$status" -ne 3 ]; then
        echo "Storage would not answer for $key — see the reply above. This is not" >&2
        echo "the same as having no backups: check {{ backup_script_dir }}/storage.env" >&2
        echo "(key, secret, bucket, endpoint) before concluding anything about the copies." >&2
        exit 1
    fi

    return "$status"
}

if [ -n "$day" ]; then
    if ! fetch "$prefix/daily/$day/_complete" "$work_dir/complete"; then
        echo "The set of $day did not finish — no _complete marker. Pick another day." >&2
        exit 1
    fi
else
    for candidate in $(seq 0 6); do
        probe="$(date -u -d "$candidate days ago" +%Y-%m-%d)"
        if fetch "$prefix/daily/$probe/_complete" "$work_dir/complete"; then
            day="$probe"
            break
        fi
    done

    if [ -z "$day" ]; then
        echo "No complete set in the last seven nights — storage answered, and none of" >&2
        echo "those nights holds a _complete marker. Check that the backup timer is" >&2
        echo "running, or name an older day with --day." >&2
        exit 1
    fi
fi

dump="$work_dir/$target.dump"

if ! fetch "$prefix/daily/$day/$target.dump" "$dump"; then
    echo "The set of $day holds no copy of $target — the database may be newer than that night." >&2
    exit 1
fi

# ⚠️ Stated, not inherited, and 0640 rather than 0644. `s3_get.py` creates this
# with a plain open(), so its mode would be root's umask — 0644 under the usual
# 022, and 0600 under a stricter one, which `{{ backup_pg_user }}` could not read
# at all. Left to the umask, the same failure ("No such file or directory" on a
# file that plainly exists) comes back the day someone tightens it, with the
# comment above still claiming the case is handled.
#
# ⚠️ And it is not world-readable, because this file IS the database. The
# directory above is 0711 so the cluster account can traverse it, which stops
# anyone from listing the names — but a mode-0644 file at a path anyone can guess
# from the database name is the whole application's data, readable by every local
# account for as long as the restore runs. Owned by the cluster account and
# readable by its group instead: root writes it, `{{ backup_pg_user }}` reads it,
# and nobody else is party to it.
chown {{ backup_pg_user | quote }}:{{ backup_pg_user | quote }} "$dump"
chmod 640 "$dump"

# ⚠️ Restored into a scratch database FIRST, and judged there. Restoring straight
# over the target would mean finding out the copy is empty after the live data is
# already gone — which is the one moment this script exists to avoid.
as_postgres createdb "$scratch"

# Errors are not fatal and the exit code is not the judgement: a dump restored
# into a fresh database always complains about roles and extensions it cannot
# recreate. What arrived is read below instead.
as_postgres pg_restore --no-owner --no-privileges -d "$scratch" "$dump" 2>&1 | tail -5 || true

# ⚠️ Every user schema, not just `public` — the same reason the replacement below
# drops every user schema. Counting only `public` made a database that keeps its
# tables elsewhere report 0 tables and be refused as an empty copy, with its data
# sitting in the scratch right there. Measured 2026-08-29 on PG 18: a database
# with one table in schema `app` counted 0 tables and 2 rows.
#
# ⚠️ And NOT the tables extensions bring with them, which is the other half of
# the same correction. Widening the schemas alone would have let an extension
# stand in for the data: PostGIS ships `spatial_ref_sys` with ~8500 rows, so a
# database that lost everything it owned but kept the extension would count one
# table and thousands of rows and be judged a healthy copy — restored over live
# data by the very check that exists to prevent it. Both queries filter the same
# way, because a disagreement between them is what produced this defect twice:
# first tables-in-one-schema against rows-in-all, now data-of-the-site against
# data-of-an-extension.
extension_tables="select 1 from pg_depend d
     where d.objid = c.oid and d.classid = 'pg_class'::regclass and d.deptype = 'e'"

# ⚠️ `m` and `p` alongside `r`, because that is what `pg_stat_user_tables` counts
# and the two have to agree. A materialized view holds rows and is not a table:
# counted by `rows` and not by `tables`, a database made of them read as 0 tables
# with thousands of rows — the exact mismatch this pair of queries has now
# produced three times, in three different disguises. Measured through a real
# dump/restore cycle on PG 18: 0 and 1000 before, 1 and 1000 after.
#
# The partitioned parent (`p`) does not double-count: its `n_live_tup` is always
# 0 and the rows live in the leaf, which is an ordinary `r`.
tables="$(as_postgres psql -tAX -d "$scratch" -c \
    "select count(*) from pg_class c
     join pg_namespace n on n.oid = c.relnamespace
     where c.relkind in ('r', 'm', 'p')
       and n.nspname not in ('pg_catalog', 'information_schema')
       and n.nspname not like 'pg\\_%'
       and not exists ($extension_tables)")"
rows="$(as_postgres psql -tAX -d "$scratch" -c \
    "select coalesce(sum(s.n_live_tup), 0) from pg_stat_user_tables s
     join pg_class c on c.oid = s.relid
     where not exists ($extension_tables)")"

# ⚠️ Emptiness before arithmetic. `[ "" -eq 0 ]` prints "integer expected" and
# returns false — and as an `if` condition that does not trip `set -e`, so the
# script would carry on and replace live data on the strength of a psql that
# never answered.
if [ -z "$tables" ] || [ -z "$rows" ]; then
    echo "Read the copy of $target but could not count what arrived — psql answered nothing." >&2
    exit 1
fi

if [ "$tables" -eq 0 ] || [ "$rows" -eq 0 ]; then
    echo "The copy of $target from $day holds $tables tables and $rows rows — refusing to restore it over live data." >&2
    exit 1
fi

# What is about to be lost, read from the target rather than assumed. An operator
# restoring the wrong database sees a number they do not expect, and that is the
# last point at which this is cheap.
current="$(as_postgres psql -tAX -d "$target" -c \
    "select coalesce(sum(n_live_tup), 0) from pg_stat_user_tables" 2>/dev/null || echo 0)"

echo "About to restore $target from the copy of $day."
echo "  copy:    $tables tables, $rows rows"
echo "  now in $target: $current rows — these are replaced"

if [ "$force" != yes ]; then
    if [ ! -t 0 ]; then
        echo "Refusing to restore without confirmation. Pass --force when running without a terminal." >&2
        exit 1
    fi

    read -r -p "Type the database name to confirm: " typed
    if [ "$typed" != "$target" ]; then
        echo "Not confirmed — nothing done."
        exit 0
    fi
fi

# ⚠️ One transaction for the drop and the restore together. psql carries on after
# an error and exits 0 by default, so a restore that broke in the middle would
# leave the schema dropped, part of the tables back, and this script reporting
# success — a database frozen half-restored. Postgres does DDL transactionally,
# so on any error the DROP rolls back with everything else and the target is
# exactly as it was.
#
# The dump goes in as plain SQL: pg_restore's own -1 does the same, but the
# ownership handover below has to be inside the SAME transaction, and only psql
# can be given both.
#
# ⚠️ WITHOUT `--no-owner --no-privileges`, unlike the scratch restore above. Those
# flags are right there — the scratch exists only to be counted and dropped, and
# insisting on roles would make it fail on a machine being rebuilt. Here they are
# wrong, and quietly: they strip every GRANT the dump carries, and `backup.sh`
# says in as many words that the cluster's per-table grants are what keep the
# sites from reading each other's statistics. Measured 2026-08-29 on PG 18: a
# dump carrying one GRANT restores with one, and with `--no-privileges` with
# none — a restore that reports success and hands the data to everybody.
#
# They also hid a second failure. The ownership loop below repairs tables and
# sequences in `public`; views, matviews, functions and types it does not touch,
# and with the owner stripped from the dump they would all come back belonging to
# whoever ran this. Keeping the dump's own ALTER ... OWNER statements is what
# actually restores ownership; the loop stays as the fallback for objects created
# by the schema itself, and for a dump made before this changed.
#
# ⚠️ Converted to SQL by root, into a file root owns — `pg_restore -f` writes as
# the caller, and {{ backup_pg_user }} cannot write into a directory holding
# credentials. Only the reading half needs to be that account, and that is the
# psql below.
pg_restore -f "$work_dir/$target.sql" "$dump"

# The plain SQL is the database too — same reasoning as the dump above.
chown {{ backup_pg_user | quote }}:{{ backup_pg_user | quote }} "$work_dir/$target.sql"
chmod 640 "$work_dir/$target.sql"

# ⚠️ Quoted by Postgres, not by this script. A role whose name carries a hyphen
# or a capital is legal and needs quoting in DDL; hand-rolling that quoting here
# would put a second, weaker copy of a rule the server already implements —
# `quote_ident` is the rule. Asked as a literal for the `format('%I')` calls
# below, which take the raw name, and as an identifier for the bare ALTER SCHEMA.
IFS='|' read -r owner_ident owner_literal <<OWNER
$(as_postgres psql -tAX -F '|' -d postgres -c \
    "select quote_ident(r), quote_literal(r) from (
         select pg_get_userbyid(datdba) as r from pg_database where datname = '$target') o")
OWNER

# ⚠️ Checked, because a substitution's exit status is not observed and an empty
# answer is not an error here. A psql that failed — the cluster going away
# between the lookup above and this one — leaves both halves empty, and the
# handover below then renders as `ALTER SCHEMA public OWNER TO ;`. That aborts
# the transaction, so the data survives; what does not survive is the
# explanation, and the operator is handed a syntax error in generated SQL on the
# day they are restoring. Asked here instead, before anything is dropped.
if [ -z "$owner_ident" ] || [ -z "$owner_literal" ]; then
    echo "Could not read who owns $target — psql answered nothing. Refusing to" >&2
    echo "restore: the schema would come back owned by whoever ran this, and the" >&2
    echo "site would meet permission denied on its own data." >&2
    exit 1
fi

# ⚠️ EVERY user schema, not just `public`. A dump carries `CREATE SCHEMA extra`
# for any schema the database has, and dropping only `public` leaves that one
# standing — the restore then aborts on `schema "extra" already exists`, rolls
# back, and the database cannot be restored at all. Measured 2026-08-29 on PG 18
# against a database with one extra schema: the transaction rolled back with the
# data intact and no way forward.
#
# This role is deliberately ignorant of the applications on the machine
# (CLAUDE.md: "a role knows about the host, not the applications on it"), so it
# cannot assume every database it protects uses `public` and nothing else. The
# catalogue is asked instead: everything except the system schemas and the ones
# extensions own.
#
# `public` is recreated explicitly because the dump does not always carry it —
# it is there by default, and a dump made from a database that still had it
# restores its contents without ever creating it.
#
# The `deptype = 'e'` test spares a schema an extension CREATED — the one its
# install script makes for itself. ⚠️ It does not spare a schema someone made and
# then installed an extension into: that relationship lives in
# `pg_extension.extnamespace`, not in `pg_depend`, so such a schema has no row
# here and is dropped. That is the right outcome — the dump recreates it along
# with its `CREATE EXTENSION` — but the predicate covers less than its name
# suggests, and this is the note saying so. ⚠️ It is qualified by `classid`
# because `pg_depend.objid` is unique per catalogue and not cluster-wide: without
# it, an extension-member row for a function or a language whose oid happens to
# equal a namespace oid would spare that schema — and the schema left standing is
# exactly the failure this loop removes. It does NOT spare an extension
# installed into `public`, which is where they land by default — that one goes
# with the schema and comes back from the dump's own `CREATE EXTENSION`, checked
# 2026-08-29 with pg_trgm. The same was true before this loop existed: `DROP
# SCHEMA public CASCADE` always took it.
{
    # ⚠️ A bounded wait for the locks, not an unbounded one. `DROP SCHEMA …
    # CASCADE` needs an AccessExclusiveLock on every object, and a site still
    # holding a session on the target blocks it — forever, by default. The
    # operator would see the "About to restore" report and then nothing at all,
    # with the flock held and no way to tell a slow restore from a stuck one.
    # A minute is long enough for a transaction that is finishing and short
    # enough to be a named refusal: the transaction rolls back and the data is
    # untouched, which is what the operator needs to be told.
    #
    # ⚠️ Set TWICE, and the second time is not redundant. Every pg_dump body opens
    # with `SET lock_timeout = 0;` — line 11 of the header, verbatim — and that
    # takes effect inside this same transaction. Set only here, the bound covers
    # the drop loop and then evaporates: the replay, the ownership handover and
    # both loops below would wait unbounded again, which is most of the
    # transaction and all of the part that runs after the data is already gone.
    # Measured on PG 18: `ALTER TABLE … OWNER TO` against a table held by another
    # session failed in 5s with the bound and hung indefinitely once the dump's
    # own SET had passed. `PGOPTIONS` would not help — the dump's SET overrides
    # that too. So it is re-issued after the body.
    echo "SET lock_timeout = '60s';"
    echo "DO \$\$ DECLARE r record; BEGIN"
    echo "  FOR r IN SELECT nspname FROM pg_namespace n"
    echo "           WHERE nspname NOT LIKE 'pg\\_%' AND nspname <> 'information_schema'"
    echo "             AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.objid = n.oid"
    echo "                             AND d.classid = 'pg_namespace'::regclass"
    echo "                             AND d.deptype = 'e') LOOP"
    echo "    EXECUTE format('DROP SCHEMA %I CASCADE', r.nspname);"
    echo "  END LOOP;"
    echo "END \$\$;"
    echo "CREATE SCHEMA IF NOT EXISTS public;"
    cat "$work_dir/$target.sql"
    # Restored after the body, which reset it to 0 — see above.
    echo "SET lock_timeout = '60s';"
    # ⚠️ Ownership handed back inside the transaction, and it is a BACKSTOP now
    # rather than the mechanism. The dump carries `ALTER SCHEMA … OWNER TO` and an
    # owner for every object it creates — that is what the flags above used to
    # strip — so a set taken by this role restores ownership on its own. What this
    # still catches: `public`, which is recreated by the loop above rather than by
    # the dump when the dump does not carry it, and anything restored from a set
    # taken BEFORE those flags were dropped, where the ownership is simply absent.
    # Without it the schema and its tables belong to whoever ran this, and the
    # site meets `permission denied` on its own database — only when it first
    # tries to read, which is after this reported success.
    #
    # Scoped to `public` deliberately: any other schema comes from the dump, which
    # creates it with its owner in the same statement.
    echo "ALTER SCHEMA public OWNER TO ${owner_ident};"
    echo "DO \$\$ DECLARE r record; BEGIN"
    echo "  FOR r IN SELECT tablename FROM pg_tables WHERE schemaname='public' LOOP"
    echo "    EXECUTE format('ALTER TABLE public.%I OWNER TO %I', r.tablename, ${owner_literal});"
    echo "  END LOOP;"
    echo "  FOR r IN SELECT sequencename FROM pg_sequences WHERE schemaname='public' LOOP"
    echo "    EXECUTE format('ALTER SEQUENCE public.%I OWNER TO %I', r.sequencename, ${owner_literal});"
    echo "  END LOOP;"
    echo "END \$\$;"
# ⚠️ `-o /dev/null` on top of `-q`. The dump opens with a `SELECT
# pg_catalog.set_config(...)`, and a SELECT's result table is not a notice —
# `-q` leaves it, so the operator's report carried a stray `set_config` and a
# `(1 row)` between "About to restore" and the outcome. On the day this is run
# that reads as something having gone wrong. Errors are untouched: they go to
# stderr, and ON_ERROR_STOP still aborts the transaction.
} | as_postgres psql -q -o /dev/null -v ON_ERROR_STOP=1 --single-transaction -d "$target" -f -

restored="$(as_postgres psql -tAX -d "$target" -c \
    "select coalesce(sum(n_live_tup), 0) from pg_stat_user_tables")"

echo "Restored $target from the copy of $day: $restored rows."
