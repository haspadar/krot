#
# Copies one object to another key inside the same bucket, server-side: the
# monthly copy is promoted from that day's daily copy without the machine
# downloading and re-uploading 42 MB it already sent an hour ago.
import os
import sys
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from s3_put import request, send  # noqa: E402


def main() -> None:
    source, destination = sys.argv[1], sys.argv[2]
    bucket = os.environ["BACKUP_S3_BUCKET"]

    # The source header carries the bucket and is escaped separately from the
    # request path: it is a header value, and an unescaped space or plus in a
    # database name would produce a signature over a different string than the
    # server reconstructs.
    copy_source = urllib.parse.quote(f"/{bucket}/{source}")

    send(
        request(
            "PUT",
            f"/{bucket}/{destination}",
            b"",
            {"x-amz-copy-source": copy_source},
        )
    )
    print(f"kept {destination}")


if __name__ == "__main__":
    main()
