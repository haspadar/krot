#
# Uploads one file to S3-compatible storage, signing the request with SigV4 out
# of the standard library.
#
# ⚠️ No rclone, no aws-cli, and that is deliberate rather than minimalist. This
# machine has 3.8 GB of memory and runs nine sites; every installed client is a
# package to keep current and a second place credentials can be read from. SigV4
# is a hundred lines of hashing that has not changed since 2012 — the cost of
# writing it is paid once, the cost of carrying a client is paid at every
# upgrade.
import datetime
import hashlib
import hmac
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

ALGORITHM = "AWS4-HMAC-SHA256"


def _sign(key: bytes, message: str) -> bytes:
    return hmac.new(key, message.encode(), hashlib.sha256).digest()


def signing_key(secret: str, stamp: str, region: str) -> bytes:
    key = ("AWS4" + secret).encode()
    for part in (stamp, region, "s3", "aws4_request"):
        key = _sign(key, part)
    return key


def object_path(bucket: str, key: str) -> str:
    """The request path for one object, escaped once and in one place.

    ⚠️ Escaping is not cosmetic here: SigV4 signs the path, so an unescaped
    character produces a signature over a string the server never reconstructs.
    The failure is a 403 that reads like a wrong key. `+` is the quiet one — it
    survives the round trip looking fine and mismatches the signature; `#`
    truncates the path at the fragment; a space raises InvalidURL and a
    non-ASCII name a UnicodeEncodeError.
    """
    return "/" + urllib.parse.quote(f"{bucket}/{key}", safe="/")


def request(method: str, path: str, payload: bytes, extra: dict | None = None):
    """Build a signed request. `path` must already be escaped — see object_path."""
    endpoint = os.environ["BACKUP_S3_ENDPOINT"].rstrip("/")
    # The scheme is separated from the host because the host is what gets
    # signed: SigV4 hashes a `host:` header, and a scheme left in it produces a
    # signature over a string the server never reconstructs — a 403 that reads
    # like a wrong key.
    scheme = "https"
    for candidate in ("https", "http"):
        if endpoint.startswith(f"{candidate}://"):
            scheme = candidate
            endpoint = endpoint[len(candidate) + 3:]
            break
    region = os.environ.get("BACKUP_S3_REGION", "auto")
    access_key = os.environ["BACKUP_S3_KEY"]
    secret = os.environ["BACKUP_S3_SECRET"]

    now = datetime.datetime.now(datetime.timezone.utc)
    amz_date = now.strftime("%Y%m%dT%H%M%SZ")
    stamp = now.strftime("%Y%m%d")

    # UNSIGNED-PAYLOAD is not used even though the transport is TLS: the hash is
    # what makes a truncated upload fail as a signature error rather than
    # succeed as a shorter object. A backup silently stored short is worse than
    # one that failed.
    payload_hash = hashlib.sha256(payload).hexdigest()

    headers = {
        "host": endpoint,
        "x-amz-content-sha256": payload_hash,
        "x-amz-date": amz_date,
    }
    headers.update({k.lower(): v for k, v in (extra or {}).items()})

    signed_headers = ";".join(sorted(headers))
    canonical_headers = "".join(f"{k}:{headers[k]}\n" for k in sorted(headers))
    canonical = (
        f"{method}\n{path}\n\n{canonical_headers}\n{signed_headers}\n{payload_hash}"
    )

    scope = f"{stamp}/{region}/s3/aws4_request"
    to_sign = (
        f"{ALGORITHM}\n{amz_date}\n{scope}\n"
        + hashlib.sha256(canonical.encode()).hexdigest()
    )
    signature = hmac.new(
        signing_key(secret, stamp, region), to_sign.encode(), hashlib.sha256
    ).hexdigest()

    headers["Authorization"] = (
        f"{ALGORITHM} Credential={access_key}/{scope}, "
        f"SignedHeaders={signed_headers}, Signature={signature}"
    )

    return urllib.request.Request(
        f"{scheme}://{endpoint}{path}",
        data=payload if method == "PUT" else None,
        method=method,
        headers=headers,
    )


def send(req) -> bytes:
    try:
        with urllib.request.urlopen(req, timeout=300) as response:
            return response.read()
    except urllib.error.HTTPError as error:
        # The body, not just the status: S3 explains refusals in it, and a bare
        # "403" sends the reader looking at credentials when the answer is
        # usually the bucket name or the region.
        body = error.read().decode(errors="replace")[:800]
        print(f"{req.get_method()} {req.selector} → {error.code}\n{body}", file=sys.stderr)
        raise SystemExit(1)
    except urllib.error.URLError as error:
        print(f"{req.get_method()} {req.selector} → {error.reason}", file=sys.stderr)
        raise SystemExit(1)


def main() -> None:
    source, key = sys.argv[1], sys.argv[2]
    bucket = os.environ["BACKUP_S3_BUCKET"]

    with open(source, "rb") as handle:
        payload = handle.read()

    send(request("PUT", object_path(bucket, key), payload))
    print(f"uploaded {key} ({len(payload)} bytes)")


if __name__ == "__main__":
    main()
