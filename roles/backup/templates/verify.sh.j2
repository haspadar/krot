#!/usr/bin/env bash
{{ ansible_managed | comment }}
#
# ⚠️ The shebang is the FIRST line, above the managed banner. Put below it the
# file is a comment followed by a shebang systemd never sees, and the unit dies
# with "Exec format error" (203/EXEC) — which names the interpreter, not the
# missing line.
#
# Restores the newest copy of one database into a scratch database and checks it
# holds data. Runs monthly.
set -euo pipefail

# ⚠️ A SIBLING of the backup's directory, not a child of it. The backup starts
# with `rm -rf` on its own path and installs the same as an EXIT trap, so a
# rehearsal working underneath it loses its downloaded dump the moment the two
# overlap — which they can: the timers are an hour apart with 20m of jitter each
# and the backup may run for up to an hour.
work_dir={{ backup_work_dir | quote }}-verify
prefix={{ backup_prefix | quote }}
scratch={{ backup_verify_database | quote }}

rm -rf "$work_dir"
mkdir -p "$work_dir"
chmod 700 "$work_dir"

# The scratch database goes too, whether the run succeeded or died halfway. A
# leftover would be picked up by the next night's backup as an ordinary database
# and copied — the rehearsal would start feeding itself.
cleanup() {
    rm -rf "$work_dir"
    dropdb --if-exists "$scratch" || true
}
trap cleanup EXIT

# The largest database, because it is the one whose restore is most likely to
# expose a problem, and because a rehearsal on the smallest proves the least.
# Asked of the cluster for the same reason the backup asks: a name written here
# would outlive the database it names.
# ⚠️ The scratch database is excluded from its own selection. Its cleanup trap
# does not run under SIGKILL — which is what systemd sends after
# TimeoutStartSec, and what an OOM kill sends on a 3.8 GB box mid-restore — so a
# leftover is a real state. Left selectable, it is by construction the same size
# as the largest real database, and the rehearsal would eventually restore its
# own leftover and declare the backup verified without touching a real one.
target="$(
    psql -tAX -d postgres -c \
        "select datname from pg_database
          where not datistemplate and datallowconn
            and datname <> '$scratch'
          order by pg_database_size(datname) desc
          limit 1"
)"

if [ -z "$target" ]; then
    echo "No database to rehearse against — the cluster returned nothing." >&2
    exit 1
fi

dump="$work_dir/$target.dump"

# ⚠️ The day is REMEMBERED, so the dump and the roles come from one set. Today
# first, yesterday as a fallback: this runs at 04:00 and the backup at 03:00,
# but a rehearsal depending on the hour between them would fail for a reason
# that has nothing to do with restoring.
#
# The marker is fetched before either: it exists only on a night that finished,
# so a partial set — a run that died on the fourth of nine uploads — is refused
# here instead of restoring from it and reporting the copies healthy.
# ⚠️ An absence and a refusal are different answers, and stderr is NOT discarded.
# `s3_get.py` exits 3 when the object is not there and 1 when storage would not
# answer at all — a rotated key, a wrong bucket or an outage. Read as one, they
# made a healthy backup look like a missing one: the probe expects most nights to
# be absent, so a 403 counted as "not this night either" and the run ended saying
# no set had finished. The restore was given this distinction on 2026-08-29 and
# the rehearsal was left with the old reading, which is the half that runs
# unattended every month and reports to nobody watching.
probe_day() {
    local candidate="$1" status=0

    "{{ backup_script_dir }}/s3_get.py" \
        "$prefix/daily/$candidate/_complete" "$work_dir/complete" || status=$?

    if [ "$status" -ne 0 ] && [ "$status" -ne 3 ]; then
        echo "Storage would not answer for the set of $candidate — see the reply above." >&2
        echo "This is not the same as having no copies: check {{ backup_script_dir }}/storage.env" >&2
        echo "(key, secret, bucket, endpoint) before concluding anything about them." >&2
        exit 1
    fi

    return "$status"
}

restored_day=""
for candidate in "$(date -u +%Y-%m-%d)" "$(date -u -d yesterday +%Y-%m-%d)"; do
    if probe_day "$candidate"; then
        restored_day="$candidate"
        break
    fi
done

if [ -z "$restored_day" ]; then
    echo "No complete set to rehearse against: storage answered, and neither today nor yesterday finished." >&2
    exit 1
fi

"{{ backup_script_dir }}/s3_get.py" "$prefix/daily/$restored_day/$target.dump" "$dump"

# ⚠️ The roles are fetched and READ, not assumed present. globals.sql is what
# makes a restore onto a clean machine possible at all, and nothing else on the
# machine ever looks at it: molecule checks it once at build time, and a
# pg_dumpall that started emitting an empty file — after a permissions change or
# a major upgrade — would be caught by nobody.
globals="$work_dir/globals.sql"
"{{ backup_script_dir }}/s3_get.py" "$prefix/daily/$restored_day/globals.sql" "$globals"

if ! grep -q '^CREATE ROLE' "$globals"; then
    echo "The copy of $restored_day carries no roles — a restore would yield databases nobody can log into." >&2
    exit 1
fi

createdb "$scratch"

# ⚠️ Errors are NOT fatal here, and the exit code of pg_restore is NOT what this
# script judges by. A dump restored into a fresh database always reports
# complaints about roles and extensions it cannot recreate, and a run that
# treats those as failure fails every month for a reason that is not a defect.
# The judgement below looks at what arrived instead.
pg_restore --no-owner --no-privileges -d "$scratch" "$dump" 2>&1 | tail -5 || true

# ⚠️ Every user schema, not just `public`, and for the same reason the restore
# counts that way: `rows` below sums across all of them, so counting tables in
# one schema makes a database that keeps them elsewhere read as structure with
# rows in it — 0 tables and n rows — and the rehearsal calls a healthy copy
# broken. The target here is whichever database is largest, so this is not a
# hypothetical shape: one database organised that way and the monthly check
# starts failing on a backup that is fine.
#
# ⚠️ And the tables extensions bring are excluded from BOTH counts. PostGIS ships
# `spatial_ref_sys` with thousands of rows, so a database that lost everything it
# owned but kept the extension would report tables and rows and pass — the
# rehearsal would declare a hollow copy healthy, which is the one thing it exists
# to catch. Kept identical to the restore's judgement deliberately: the two
# answer the same question, and every time they have differed the difference has
# been a defect.
extension_tables="select 1 from pg_depend d
     where d.objid = c.oid and d.classid = 'pg_class'::regclass and d.deptype = 'e'"

tables="$(
    psql -tAX -d "$scratch" -c \
        "select count(*) from pg_class c
          join pg_namespace n on n.oid = c.relnamespace
          where c.relkind = 'r'
            and n.nspname not in ('pg_catalog', 'information_schema')
            and n.nspname not like 'pg\\_%'
            and not exists ($extension_tables)"
)"

# Read before either is judged, so the emptiness check below covers both. Schema
# without rows is the failure this check exists for: pg_restore exits 0 on a
# dump that carries structure and nothing else, and every other signal short of
# counting says the backup works.
rows="$(
    psql -tAX -d "$scratch" -c \
        "select coalesce(sum(s.n_live_tup), 0) from pg_stat_user_tables s
          join pg_class c on c.oid = s.relid
          where not exists ($extension_tables)"
)"

# ⚠️ Compared as a STRING against emptiness first. `[ "" -eq 0 ]` prints
# "integer expected" and returns FALSE — and because it is an `if` condition,
# set -e does not fire. The rehearsal then prints its success line with blanks
# where the numbers go and exits 0, manufacturing the one signal that separates
# a backup from a hope out of a psql that never answered.
if [ -z "$tables" ] || [ -z "$rows" ]; then
    echo "Restored $target but could not read what arrived — psql answered nothing." >&2
    exit 1
fi

if [ "$tables" -eq 0 ]; then
    echo "Restored $target from $restored_day and found no tables — the copy is empty." >&2
    exit 1
fi

if [ "$rows" -eq 0 ]; then
    echo "Restored $target: $tables tables, not one row. The copy carries schema only." >&2
    exit 1
fi

echo "Restored $target from the copy of $restored_day: $tables tables, $rows rows."
