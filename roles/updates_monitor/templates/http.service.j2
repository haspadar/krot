{{ ansible_managed | comment }}
[Unit]
Description=Serve cached machine update status on loopback
After=network.target

[Service]
User=nobody
Group=nogroup
ExecStart=/usr/bin/python3 /usr/local/lib/krot-updates/check.py serve --port {{ updates_monitor_port }} --stale {{ updates_monitor_stale_after }}
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
