{{ ansible_managed | comment }}
location = {{ updates_monitor_path }} {
    proxy_pass http://127.0.0.1:{{ updates_monitor_port }}/;
    proxy_cache off;
    proxy_hide_header Server;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
    auth_basic off;
    access_log off;
}
