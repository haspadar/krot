{{ ansible_managed | comment }}

[Unit]
Description=Rebuild the GoAccess reports {{ goaccess_interval }}

[Timer]
OnCalendar={{ goaccess_interval }}
# Every host with this role would otherwise rebuild on the same second.
RandomizedDelaySec=300
# A machine that was off when the timer was due still gets its report rather
# than silently skipping the window.
Persistent=true

[Install]
WantedBy=timers.target
