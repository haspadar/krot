{{ ansible_managed | comment }}
# Agents to count as crawlers in the humans report, on top of the ones GoAccess
# ships in /etc/goaccess/browsers.list. Passed with -b, which adds to that list
# rather than replacing it.
#
# Format: <name><TAB>Crawlers. The name matches as a substring of the user
# agent. "Crawlers" is spelled exactly so — any other spelling makes GoAccess
# invent a browser category instead, which raises the visitor count rather than
# lowering it.
{% for agent in goaccess_extra_crawlers %}
{{ agent }}	Crawlers
{% endfor %}
