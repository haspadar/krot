{{ ansible_managed | comment }}

/var/log/nginx/*.log {
    daily
    rotate {{ nginx_log_retention_days }}
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        # USR1 makes nginx reopen its log files without dropping connections.
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}
