{{ ansible_managed | comment }}
# Without this every request is logged as coming from Cloudflare, and the
# impression stats the recipient builds from these logs become meaningless.
#
# Ranges come from /etc/krot/cloudflare-ranges.txt, the same file the firewall
# role maintains — two separately-maintained CF lists would inevitably drift.

{% for cidr in nginx_cloudflare_ranges %}
set_real_ip_from {{ cidr }};
{% endfor %}

real_ip_header {{ nginx_real_ip_header }};
# Trust only the header set by the immediate peer: with recursive lookups on, a
# forged X-Forwarded-For chain could spoof the visitor address.
real_ip_recursive off;
