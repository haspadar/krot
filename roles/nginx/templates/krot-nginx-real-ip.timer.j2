{{ ansible_managed | comment }}
[Unit]
Description=Daily refresh of the nginx real-IP ranges

[Timer]
OnCalendar=*-*-* {{ nginx_cloudflare_refresh_hour }}:00:00
# Spread the fetch so every machine does not hit Cloudflare at the same second.
RandomizedDelaySec=30m
# A machine that was off at the scheduled time still refreshes on next boot.
Persistent=true

[Install]
WantedBy=timers.target
