{{ ansible_managed | comment }}
{% if nginx_log_json %}
# JSON lines: a log shipper parses them without a bespoke regex, and new fields
# can be added without breaking whatever already reads the old ones.
# $remote_addr is the real visitor once the real-IP block has rewritten it.
log_format {{ nginx_log_format_name }} escape=json
    '{'
    '"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"host":"$http_host",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"bytes":$body_bytes_sent,'
    '"referer":"$http_referer",'
    '"user_agent":"$http_user_agent",'
    '"request_time":$request_time,'
    '"upstream_time":"$upstream_response_time",'
    '"cf_ray":"$http_cf_ray",'
    '"cf_country":"$http_cf_ipcountry",'
    '"site":"$http_host"'
    '}';
{% else %}
log_format {{ nginx_log_format_name }} '$remote_addr - $remote_user [$time_local] '
                 '"$request" $status $body_bytes_sent '
                 '"$http_referer" "$http_user_agent" '
                 'host=$http_host time=$request_time';
{% endif %}
